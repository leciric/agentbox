From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alyssa Ross <alyssa.ross@unikie.com>
Date: Wed, 28 Sep 2022 12:18:19 +0000
Subject: [PATCH 1/2] build: use local vhost

Signed-off-by: Alyssa Ross <alyssa.ross@unikie.com>
Signed-off-by: Alyssa Ross <hi@alyssa.is>

[AgentBox: rebased from v50.0 onto v53.0 (vhost 0.16.0,
 vhost-user-backend 0.22.0); keeps default-features = false.]
---
 Cargo.lock | 4 ----
 Cargo.toml | 4 ++--
 2 files changed, 2 insertions(+), 6 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 539337cd..5b392ebe 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -2595,8 +2595,6 @@ dependencies = [
 [[package]]
 name = "vhost"
 version = "0.16.0"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "ee90657203a8644e9a0860a0db6a7887d8ef0c7bc09fc22dfa4ae75df65bac86"
 dependencies = [
  "bitflags 2.13.0",
  "libc",
@@ -2608,8 +2606,6 @@ dependencies = [
 [[package]]
 name = "vhost-user-backend"
 version = "0.22.0"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "d5925983d8fb537752ad3e26604c0a17abfa5de77cb6773a096c8a959c9eca0f"
 dependencies = [
  "libc",
  "log",
diff --git a/Cargo.toml b/Cargo.toml
index 38bb9881..f3e6f5b8 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -64,8 +64,8 @@ seccompiler = "0.5.0"
 vfio-bindings = { version = "0.6.2", default-features = false }
 vfio-ioctls = { version = "0.7.0", default-features = false }
 vfio_user = { version = "0.1.3", default-features = false }
-vhost = { version = "0.16.0", default-features = false }
-vhost-user-backend = { version = "0.22.0", default-features = false }
+vhost = { path = "../vhost/vhost", default-features = false }
+vhost-user-backend = { path = "../vhost/vhost-user-backend", default-features = false }
 virtio-bindings = "0.2.6"
 virtio-queue = "0.17.0"
 vm-fdt = "0.3.0"
