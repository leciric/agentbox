 /// find an available GPU itself.
 const DEFAULT_DRM_FD: i32 = -1;
 
+/// Whether a canonical path names a DRM render node (/dev/dri/renderD*). Compared as a string:
+/// Path::starts_with compares whole components, so "/dev/dri/renderD128" doesn't start with
+/// "/dev/dri/renderD" and no render node was ever accepted.
+fn is_render_node_path(path: &Path) -> bool {
+    path.to_str()
+        .and_then(|p| p.strip_prefix("/dev/dri/renderD"))
+        .is_some_and(|n| !n.is_empty() && n.bytes().all(|b| b.is_ascii_digit()))
+}
+
 /// Check if the given rutabaga path is a valid GPU path.
 fn is_valid_gpu_path(rpath: &RutabagaPath) -> bool {
     if rpath.path_type != RUTABAGA_PATH_TYPE_GPU {
         return false;
     }
 
-    canonicalize(&rpath.path)
-        .map(|path| path.starts_with("/dev/dri/renderD") && path.exists())
-        .unwrap_or_default()
+    let valid = canonicalize(&rpath.path)
+        .map(|path| is_render_node_path(&path) && path.exists())
+        .unwrap_or_default();
+    if !valid {
+        warn!("virglrenderer: GPU path {:?} isn't a render node, ignored", rpath.path);
+    }
+    valid
 }
 
