+#[cfg(test)]
+mod render_node_path_tests {
+    use super::is_render_node_path;
+    use std::path::Path;
+
+    #[test]
+    fn render_nodes() {
+        assert!(is_render_node_path(Path::new("/dev/dri/renderD128")));
+        assert!(is_render_node_path(Path::new("/dev/dri/renderD129")));
+    }
+
+    #[test]
+    fn not_render_nodes() {
+        assert!(!is_render_node_path(Path::new("/dev/dri/card0")));
+        assert!(!is_render_node_path(Path::new("/dev/dri/renderD")));
+        assert!(!is_render_node_path(Path::new("/dev/dri/renderD128/x")));
+        assert!(!is_render_node_path(Path::new("/dev/dri/renderDx")));
+        assert!(!is_render_node_path(Path::new("/tmp/dev/dri/renderD128")));
+    }
+}
