<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The macOS agentbox's entitlements (scripts/mac-sign.sh): Apple's
  Virtualization framework, which the experimental vz driver runs AgentBox's VM
  with in the agentbox process itself (internal/hostvm/chv/vz.go). The app's
  copy gets the same from desktop/build/entitlements.mac.plist.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
