#cloud-config
# AgentBox's VM, set up by cloud-init on its first boot from the seed
# `agentbox vm init` wrote (internal/hostvm/chv/user-data.yaml.tmpl). The rest
# of it, Incus's bridge and profile and the user's access to Incus, is
# `agentbox host setup`, run in here afterwards as on any Linux host.
hostname: {{q .Hostname}}
ssh_pwauth: false
disable_root: true
# The VM's host keys are made once and kept: a new seed (a new instance to
# cloud-init) would otherwise make new ones, and the front end's known_hosts
# would no longer match them.
ssh_deletekeys: false

# The host's user, with the same UID and GID so the files on the shared home
# are theirs on both sides, but a home of their own on the VM's disk: the
# host's home is mounted at its own path. bootcmd makes them, since cloud-init's
# users can't be given a GID; users below finds them made and adds the rest.
bootcmd:
  - [cloud-init-per, instance, agentbox-user, sh, -c, {{q .MakeUser}}]
users:
  - name: {{q .User}}
    gecos: AgentBox
    shell: /bin/bash
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - {{q .AuthorizedKey}}

write_files:
  # Memory the host plugs in (virtio-mem) goes online at once, and where the
  # kernel can still spare it, as ZONE_MOVABLE: memory in the Normal zone
  # fills with the kernel's own pages and can't be unplugged again. auto-movable
  # keeps movable memory to {{.MovableRatio}}% of the rest, so the kernel's own
  # memory (page tables, slab, the memmap of every block plugged in) always has
  # room: past that ratio, a plug goes to Normal. provision.sh sets the same
  # at once on the first boot, which this only reaches on the next.
  - path: /etc/default/grub.d/90-agentbox.cfg
    content: |
      GRUB_CMDLINE_LINUX="$GRUB_CMDLINE_LINUX {{.KernelArgs}}"
  # Kernel limits every agent's container shares, since their users are all
  # the same few UIDs to the VM's kernel: Debian's defaults are a desktop's for
  # one user, and sized from the memory the VM boots with, not what it grows
  # to. With 128 inotify instances (incus-base's 1024 only once sysctl reruns)
  # and 30720 watches, a few agents in, a new container's systemd dies with
  # "Failed to create control group inotify object: Too many open files". The
  # keys are Incus's production settings: every container's systemd makes
  # keyrings, and 200 keys for all of them run out as fast. The rest (file-max,
  # nr_open, max_map_count) are systemd's already, and incus.service has
  # LimitNOFILE=1048576.
  - path: /etc/sysctl.d/60-agentbox.conf
    content: |
      fs.inotify.max_user_instances = 8192
      fs.inotify.max_user_watches = 524288
      fs.inotify.max_queued_events = 65536
      kernel.keys.maxkeys = 2000
      kernel.keys.maxbytes = 2000000
      fs.aio-max-nr = 524288
  # Says this is AgentBox's VM to the agentbox in it (hostos.Marker), whoever
  # runs it and with whatever environment: it is never the VM's front end.
  - path: /etc/agentbox/vm
    content: |
      linux
  # virtiofsd holds a file descriptor open for every inode of the shared home
  # this kernel keeps cached (--inode-file-handles=never: file handles need
  # privileges it hasn't got), and fails the VM's reads with ENFILE ("Too many
  # open files in system") once it has used all it may have: its RLIMIT_NOFILE,
  # usually 524288. Nothing makes this kernel forget them short of memory
  # pressure, and git, npm and go walking agents' worktrees on the share cache
  # hundreds of thousands. So once there are more than {{.FuseInodeLimit}}, it
  # drops its dentry and inode caches, which gives virtiofsd its descriptors
  # back (FUSE's forget).
  - path: /usr/local/lib/agentbox/trim-share-inodes
    permissions: "0755"
    content: |
      #!/bin/sh
      n=$(awk '$1 == "fuse_inode" { print $2 }' /proc/slabinfo)
      [ "${n:-0}" -gt {{.FuseInodeLimit}} ] || exit 0
      echo "$n inodes of the shared home cached: dropping the dentry and inode caches"
      echo 2 >/proc/sys/vm/drop_caches
  - path: /etc/systemd/system/agentbox-trim-share-inodes.service
    content: |
      [Unit]
      Description=AgentBox: keep virtiofsd's file descriptors for the shared home in bounds
      [Service]
      Type=oneshot
      ExecStart=/usr/local/lib/agentbox/trim-share-inodes
  - path: /etc/systemd/system/agentbox-trim-share-inodes.timer
    content: |
      [Unit]
      Description=AgentBox: keep virtiofsd's file descriptors for the shared home in bounds
      [Timer]
      OnBootSec=1min
      OnUnitActiveSec=30s
      AccuracySec=5s
      [Install]
      WantedBy=timers.target
  # ssh in the VM, git's to fetch and push over ssh included, is the host
  # user's: their keys, known hosts and config, from the shared home. ssh
  # reads the home it finds in passwd, the VM's own, whose .ssh holds the
  # front end's authorized key; so each boot links what the host's .ssh has
  # into it, and its config includes the host's. What the VM's .ssh has of its
  # own stays. An ssh agent on the host can't be reached from the VM: a key
  # with a passphrase won't work here.
  - path: /usr/local/lib/agentbox/share-ssh
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      host={{sh .Home}}/.ssh
      vm={{sh .GuestHome}}/.ssh
      mkdir -p "$vm"
      chmod 700 "$vm"
      [ -d "$host" ] || exit 0
      for f in "$host"/* "$host"/.[!.]*; do
        [ -e "$f" ] || continue
        name=${f##*/}
        case $name in authorized_keys | authorized_keys2 | config | environment | rc) continue ;; esac
        [ -e "$vm/$name" ] || [ -L "$vm/$name" ] || ln -s "$f" "$vm/$name"
      done
      for l in "$vm"/* "$vm"/.[!.]*; do
        if [ -L "$l" ] && [ ! -e "$l" ]; then
          case $(readlink "$l") in "$host"/*) rm -f "$l" ;; esac
        fi
      done
      if [ ! -e "$vm/config" ] || grep -q '^# agentbox: ' "$vm/config"; then
        cat >"$vm/config.new" <<EOF
      # agentbox: written at every start of AgentBox's VM, so ssh here is yours
      # from the host ($host). Change that instead, or remove this line to keep
      # this file as it is.
      Include $host/config
      Host *
          UserKnownHostsFile ~/.ssh/known_hosts $host/known_hosts
      EOF
        chmod 600 "$vm/config.new"
        mv -f "$vm/config.new" "$vm/config"
      fi
  - path: /etc/systemd/system/agentbox-share-ssh.service
    content: |
      [Unit]
      Description=AgentBox: ssh in the VM as the host's user does
      RequiresMountsFor={{.Home}}
      [Service]
      Type=oneshot
      User={{.User}}
      ExecStart=/usr/local/lib/agentbox/share-ssh
      [Install]
      WantedBy=multi-user.target
  # Agents' containers mustn't reach the host's own loopback services: passt
  # maps the VM's connections to the gateway to the host's 127.0.0.1, and
  # the DNS address answers DNS only. The VM itself may (the daemon needs
  # nothing there, but ssh-ing out to the host is fine).
  - path: /etc/agentbox/host-guard.nft
    content: |
      table inet agentbox-host
      delete table inet agentbox-host
      table inet agentbox-host {
        chain forward {
          type filter hook forward priority -10; policy accept;
          iifname "incusbr0" ip daddr {{.Gateway}} drop
          iifname "incusbr0" ip daddr {{.DNS}} udp dport != 53 drop
          iifname "incusbr0" ip daddr {{.DNS}} tcp dport != 53 drop
          iifname "incusbr0" ip daddr {{.DNS}} meta l4proto != { tcp, udp } drop
        }
      }
  - path: /etc/systemd/system/agentbox-host-guard.service
    content: |
      # A firewall unit, like Debian's nftables.service: without
      # DefaultDependencies=no, ordering it before network-pre.target makes a
      # cycle through basic.target and sockets.target, and systemd breaks it
      # by dropping some other job at boot (sshd-vsock.socket, incus.socket).
      [Unit]
      Description=AgentBox: keep agents off the host's loopback services
      DefaultDependencies=no
      Wants=network-pre.target
      Before=network-pre.target incus.service shutdown.target
      Conflicts=shutdown.target
      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/sbin/nft -f /etc/agentbox/host-guard.nft
      [Install]
      WantedBy=sysinit.target
{{- range .Forwards}}
  # vsock port {{.Port}} to {{.What}}, for the host's end (the supervisor).
  - path: /etc/systemd/system/agentbox-vsock-{{.Port}}.service
    content: |
      [Unit]
      Description=AgentBox: vsock port {{.Port}} to {{.What}}
      After=network.target
      [Service]
{{- if .User}}
      User={{.User}}
{{- else}}
      DynamicUser=yes
{{- end}}
      ExecStart=/usr/bin/socat VSOCK-LISTEN:{{.Port}},fork,reuseaddr {{.To}}
      Restart=always
      RestartSec=1
      [Install]
      WantedBy=multi-user.target
{{- end}}
  # Only the host is to reach those ports: vsock_loopback would let anything
  # in the VM, an agent's container included, connect to them (and so to the
  # daemon's socket) at CID 1.
  - path: /etc/modprobe.d/agentbox-vsock.conf
    content: |
      install vsock_loopback /bin/false
  - path: /usr/local/lib/agentbox/provision.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      set -x
      export DEBIAN_FRONTEND=noninteractive

      # The limits above, now rather than at the next boot.
      sysctl -q --system || echo "warning: some of the VM's kernel limits aren't set" >&2
      echo online >/sys/devices/system/memory/auto_online_blocks || true
{{- range .KernelParams}}
      echo {{.Value}} >/sys/module/memory_hotplug/parameters/{{.Name}} || true
{{- end}}
      update-grub

      # The host's home, shared by virtiofsd, at its own path.
      mkdir -p {{sh .Home}}
      grep -q '^home ' /etc/fstab ||
        echo {{sh .FstabLine}} >>/etc/fstab
      systemctl daemon-reload
      mountpoint -q {{sh .Home}} || mount {{sh .Home}} || echo "warning: the host's home isn't shared into the VM" >&2
      systemctl enable agentbox-share-ssh.service
      systemctl start agentbox-share-ssh.service || echo "warning: ssh in the VM isn't set up as the host's" >&2

      # Agents' Android emulators run on the VM's /dev/kvm (the host's KVM,
      # nested), which udev gives to the kvm group, and the daemon checks it
      # as the user (agent.CheckKVM). host setup does the same, but only once.
      if getent group kvm >/dev/null; then usermod -aG kvm {{sh .User}}; fi

      # The ports the host reaches the VM on first, with the image's own socat.
      # (sshd is on vsock port {{.PortSSH}} already: systemd-ssh-generator puts
      # it there in a VM, from the first boot, before any of this.)
      echo 'man-db man-db/auto-update boolean false' | debconf-set-selections
      systemctl disable --now man-db.timer || true
      if ! command -v socat >/dev/null; then
        apt-get update -q --error-on=any
        apt-get install -y -q --no-install-recommends socat
      fi
      systemctl enable --now agentbox-trim-share-inodes.timer
      systemctl enable --now{{range .Forwards}} agentbox-vsock-{{.Port}}.service{{end}}

      apt-get update -q --error-on=any
      apt-get install -y -q --no-install-recommends {{.Packages}}
      # reenable: a VM set up before the unit moved to sysinit.target keeps
      # no stale multi-user.target link.
      systemctl reenable agentbox-host-guard.service
      systemctl start agentbox-host-guard.service

      # Incus's pool, on the disk the host gives the VM for it. agentbox host
      # setup, run next, leaves a pool named default alone.
      systemctl start incus.socket
      incus storage show default >/dev/null 2>&1 ||
        incus storage create default btrfs source={{sh .PoolDevice}}

runcmd:
  - [/usr/local/lib/agentbox/provision.sh]
