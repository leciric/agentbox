{
  "name": "agentbox-desktop",
  "private": true,
  "version": "0.3.0",
  "description": "AgentBox desktop app: a client of the AgentBox daemon",
  "author": "AgentBox",
  "license": "MIT",
  "repository": "https://github.com/leciric/agentbox.git",
  "desktopName": "agentbox-desktop.desktop",
  "main": "out/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-coverage --test \"src/**/*.test.ts\"",
    "dist": "node scripts/dist.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@novnc/novnc": "^1.7.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.47.0",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "dev.agentbox.desktop",
    "productName": "AgentBox",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "AgentBox-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "../bin/agentbox",
          "to": "bin/agentbox"
        },
        {
          "from": "../bin/agentbox-linux",
          "to": "bin/agentbox-linux"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "agentbox-desktop",
      "artifactName": "AgentBox-${version}-${arch}.${ext}",
      "synopsis": "Isolated machines for AI coding agents",
      "syncDesktopName": true,
      "maintainer": "leandro@linting.dev",
      "extraResources": [
        {
          "from": "../bin/agentbox",
          "to": "bin/agentbox"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "AgentBox",
      "extraResources": [
        {
          "from": "../bin/agentbox.exe",
          "to": "bin/agentbox.exe"
        },
        {
          "from": "../bin/agentbox-linux",
          "to": "bin/agentbox-linux"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "AgentBox-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "AgentBox-${version}-${arch}-portable.${ext}"
    }
  }
}
