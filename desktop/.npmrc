# onnxruntime-node (a dev dependency of the voice libraries) downloads its CUDA
# binaries from nuget on install. The app runs the models in the renderer on
# onnxruntime-web and never loads the Node binding, so skip it for every npm
# ci/install. Read by both versions in the tree (1.30 and kokoro-js's 1.21).
onnxruntime-node-install=skip
onnxruntime-node-install-cuda=skip
