  "text": {
    "//": "px. Six sizes and nothing between them: micro for metadata under a row, caption for labels and counts, ui for dense controls, body for reading, heading for a panel's title, display for a page's.",
    "micro": 11,
    "caption": 12,
    "ui": 13,
    "body": 14,
    "heading": 16,
    "display": 20
  },
  "space": {
    "//": "px, a 4px grid: hair between an icon and its label, tight inside a control, snug between rows, base for a panel's padding, loose between groups, wide around a page.",
    "hair": 4,
    "tight": 8,
    "snug": 12,
    "base": 16,
    "loose": 24,
    "wide": 32
  },
  "radius": {
    "//": "px. sm a chip or a key, md a row or a small control, lg a button or an input, xl a card, 2xl a dialog or the composer, 3xl the largest sheet. Tailwind's rounded-* and the native radius::* are these.",
    "sm": 4,
    "md": 6,
    "lg": 8,
    "xl": 10,
    "2xl": 12,
    "3xl": 16
  },
  "elevation": {
    "//": "Three levels: a panel at rest casts nothing, a menu or popover a close soft drop, a dialog a deep one. Each is [x, y, blur, spread, colour role, strength of that role].",
    "pop": [
      [0, 8, 24, -6, "shadow-soft", 1],
      [0, 1, 2, 0, "shadow-soft", 0.5]
    ],
    "modal": [[0, 24, 60, -16, "shadow-deep", 0.7]]
  }
}
